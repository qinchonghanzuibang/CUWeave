{
  "name": "@cuweave/db",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:validate": "tsx src/validate-migration.ts",
    "dev:seed": "tsx src/seed-development.ts",
    "requirements:seed": "tsx src/seed-requirements.ts",
    "role:grant": "tsx src/grant-role.ts",
    "auth:revoke-ineligible": "tsx src/revoke-ineligible-auth.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cuweave/domain": "workspace:*",
    "@cuweave/requirements": "workspace:*",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@cuweave/config": "workspace:*",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
