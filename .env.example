# Local development values only. Never reuse these credentials in production.
POSTGRES_DB=cuweave
POSTGRES_USER=cuweave
POSTGRES_PASSWORD=cuweave-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cuweave:cuweave-local-only@127.0.0.1:5432/cuweave

# Authentication. Generate a unique 32+ character secret for every deployment.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3000

# Local-only magic-link preview. This is forcibly disabled in production.
AUTH_DEV_MODE=true

# Required when AUTH_DEV_MODE is disabled. Never prefix server secrets with NEXT_PUBLIC_.
AUTH_SMTP_URL=smtp://username:password@smtp.example.invalid:587
AUTH_EMAIL_FROM=CUWeave <noreply@example.invalid>

# Optional path to the audited Another Planner checkout for data:import:local.
CUWEAVE_UPSTREAM_DIR=/absolute/path/to/another-cuhk-course-planner

# Optional. The status page omits the link when this is unset.
GITHUB_REPOSITORY_URL=https://github.com/qinchonghanzuibang/CUWeave
