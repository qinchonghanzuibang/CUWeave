# Local development values only. Never reuse these credentials in production.
POSTGRES_DB=cuweave
POSTGRES_USER=cuweave
POSTGRES_PASSWORD=cuweave-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cuweave:cuweave-local-only@127.0.0.1:5432/cuweave
# Optional direct/unpooled URL used only by migration commands.
DATABASE_MIGRATION_URL=postgresql://cuweave:cuweave-local-only@127.0.0.1:5432/cuweave
DATABASE_SSL=false
DATABASE_POOL_MAX=5

# Authentication. Generate a unique 32+ character secret for every deployment.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
# Exact comma-separated origins only. Wildcards are not accepted.
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000

# Local-only OTP test mode. Both overrides are forcibly disabled in production.
AUTH_DEV_MODE=true
AUTH_TEST_EMAIL_DOMAIN=cuweave.local
AUTH_TEST_OTP=123456
# Optional server-only exact-email login exceptions. This grants no role.
AUTH_OPERATOR_EMAILS=operator@example.invalid

# Required when AUTH_DEV_MODE is disabled. Never prefix server secrets with NEXT_PUBLIC_.
AUTH_SMTP_URL=smtp://username:password@smtp.example.invalid:587
AUTH_EMAIL_FROM=CUWeave <noreply@example.invalid>

# Preview authentication is disabled unless both values explicitly opt into an
# isolated Preview database and an exact BETTER_AUTH_URL / trusted origin.
AUTH_PREVIEW_MODE=disabled
PREVIEW_DATABASE_ISOLATED=false

# Enable only behind a platform proxy whose forwarded headers are trusted.
TRUST_PROXY_HEADERS=false
# Generate a separate 32+ character secret. Only keyed hashes are stored.
RATE_LIMIT_HASH_SECRET=replace-with-a-separate-32-character-secret

# Optional path to the audited Another Planner checkout for offline imports.
CUWEAVE_UPSTREAM_DIR=/absolute/path/to/another-cuhk-course-planner

# Optional. The status page omits the link when this is unset.
GITHUB_REPOSITORY_URL=https://github.com/qinchonghanzuibang/CUWeave

# Requirements remain server-side and unavailable unless explicitly enabled.
FEATURE_REQUIREMENTS_ENABLED=false

# Production smoke test inputs (command-line environment only).
SMOKE_BASE_URL=http://127.0.0.1:3000
SMOKE_COURSE_CODE=IERG5001
